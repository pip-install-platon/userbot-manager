# Copy to .env and fill in real values. Never commit .env.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=userbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=userbot

REDIS_URL=redis://localhost:6379/0

# 32 raw bytes, base64. Generate:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# https://my.telegram.org — userbot account only. Do not reuse the admin bot account.
API_ID=
API_HASH=
# CRITICAL SECRET. Pyrogram session of the userbot account.
# python -m userbot.generate_session
SESSION_STRING=

# BotFather token for the admin bot. A different Telegram identity from the userbot.
BOT_TOKEN=

ALL_OPERATORS_BUSY_TEXT=Все операторы заняты, попробуйте позже.
AUTO_ASSIGN=true

# Optional. On admin-bot startup an active superadmin row is created if missing.
SUPERADMIN_TELEGRAM_ID=
SUPERADMIN_DISPLAY_NAME=Superadmin

LOG_LEVEL=INFO
MEDIA_MAX_BYTES=20971520
STATUS_TTL_SECONDS=60
HEARTBEAT_TTL_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=30
